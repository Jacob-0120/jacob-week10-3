<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Circle Calculator - Chang-ching fu</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
            line-height: 1.6;
        }
        .container {
            max-width: 400px;
            padding: 20px;
            border: 1px solid #ccc;
            border-radius: 8px;
        }
        input, button {
            padding: 8px;
            margin-top: 10px;
        }
        .result {
            margin-top: 20px;
            font-weight: bold;
            color: #333;
        }
    </style>
</head>
<body>

    <div class="container">
        <h2>Circle Properties Calculator</h2>
        <p>Enter a radius below:</p>
        
        <input type="number" id="radiusInput" placeholder="e.g., 5">
        <button onclick="displayResults()">Calculate</button>

        <div class="result">
            <p id="circumferenceOutput"></p>
            <p id="areaOutput"></p>
        </div>
    </div>

    <script>
        // 依照題目要求的拼寫：calcCircumfrence
        function calcCircumfrence(radius) {
            // 圓周長公式: 2 * π * r
            const circumference = 2 * Math.PI * radius;
            const outputString = `The circumference is ${circumference.toFixed(2)}`;
            console.log(outputString); 
            return outputString;
        }

        function calcArea(radius) {
            // 圓面積公式: π * r^2
            const area = Math.PI * radius * radius;
            const outputString = `The area is ${area.toFixed(2)}`;
            console.log(outputString);
            return outputString;
        }

        // 讀取輸入值並將結果顯示在網頁上的整合函數
        function displayResults() {
            const radiusValue = document.getElementById('radiusInput').value;
            const radius = parseFloat(radiusValue);

            // 簡單的防呆機制
            if (isNaN(radius) || radius <= 0) {
                alert("Please enter a valid positive number.");
                return;
            }

            // 呼叫題目要求的兩個函數並將字串寫入 HTML
            document.getElementById('circumferenceOutput').innerText = calcCircumfrence(radius);
            document.getElementById('areaOutput').innerText = calcArea(radius);
        }
    </script>

</body>
</html>
